rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Staff collection
    match /staff/{staffId} {
      allow read, write: if true;
    }

    // Shift definitions and compensation rates
    match /shiftDefinitions/{code} {
      allow read, write: if true;
    }

    // Monthly duty schedules
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
